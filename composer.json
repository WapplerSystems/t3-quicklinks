{
    "name": "wapplersystems/quicklinks",
    "description": "Frontend quicklinks with a drag & drop manager, order stored per frontend user or in a cookie.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems"
        }
    ],
    "require": {
        "typo3/cms-core": "^14"
    },
    "autoload": {
        "psr-4": {
            "Wapplersystems\\WsQuicklinks\\": "Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ws_quicklinks"
        }
    }
}
